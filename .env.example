# Copie para .env e preencha. Nunca versione .env.
APP_ENV=development                      # development | test | homolog | production
APP_BASE_URL=http://localhost:3000        # domínio canônico com protocolo
DATABASE_URL=postgres://rh_app:rh_app_dev@127.0.0.1:5432/rh_dev          # papel da aplicação
DATABASE_OWNER_URL=postgres://rh_owner:rh_owner_dev@127.0.0.1:5432/rh_dev # papel dono, só para migrações
BETTER_AUTH_SECRET=                       # openssl rand -base64 32
CPF_ENC_KEY_V1=                           # 32 bytes em base64; cifra do CPF
CPF_HMAC_KEY_V1=                          # 32 bytes em base64; índice de duplicidade
CPF_KEY_VERSION=1
IMPORT_ENC_KEY_V1=                        # 32 bytes em base64; prévia cifrada da importação
EMAIL_TRANSPORT=file                      # file | smtp | memory
EMAIL_FROM="Portal do Colaborador <portal@example.invalid>"   # remetente definido na implantação
SMTP_URL=                                 # smtps://usuario:senha@host:465 quando EMAIL_TRANSPORT=smtp
EMAIL_ALLOWLIST=                          # homologação: lista separada por vírgula de destinatários permitidos
PASSWORD_BREACH_CHECK=off                 # on | off; consulta por k anonimato (PAR-20)
TRUSTED_IP_HEADER=                        # cabeçalho garantido pela plataforma, ex.: x-forwarded-for
LOG_LEVEL=info
